

variable "smb_server" {
	description = "The IP address or hostname of the SMB server."
	type        = string
}

variable "smb_share" {
	description = "The name of the SMB share."
	type        = string
}

variable "smb_user" {
	description = "The username for the SMB share."
	type        = string
}

variable "smb_password" {
	description = "The password for the SMB user."
	sensitive   = true
}

resource "null_resource" "add_smb_iso_storage" {
	# This resource will trigger on any changes to the input variables.
	triggers = {
		smb_server = var.smb_server
		smb_share  = var.smb_share
	}

	connection {
		type        = "ssh"
		user        = "root"
		host        = "your-proxmox-host"
		private_key = file("~/.ssh/id_rsa") # Path to your private SSH key
	}

	provisioner "remote-exec" {
		inline = [
		"pvesm add cifs iso_storage --server ${var.smb_server} --share ${var.smb_share} --username ${var.smb_user} --password '${var.smb_password}' --content iso"
		]
	}

	# This provisioner will run when the resource is destroyed.
	provisioner "remote-exec" {
		when       = destroy
		inline = [
		"pvesm remove iso_storage"
		]
	}
}